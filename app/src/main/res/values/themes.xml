<resources>
    <!-- 工厂使用：白底黑字、高对比、无彩色主题 -->
    <style name="Theme.PatchNotify" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="colorPrimary">#FF000000</item>
        <item name="colorPrimaryDark">#FF000000</item>
        <item name="colorAccent">#FF000000</item>
        <item name="android:textColorPrimary">#FF000000</item>
        <item name="android:textColorSecondary">#FF333333</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="FactoryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_factory</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#FF000000</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="FactoryButtonPrimary" parent="FactoryButton">
        <item name="android:background">@drawable/btn_factory_primary</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
</resources>
